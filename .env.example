# Wrench Wise Project Lab - Environment Configuration
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DB_PATH=data/projectlab.db

# Cryptographic signing secret for certificate check digits (MUST change in production)
CERT_SECRET=dev-only-cert-secret-change-me

# Admin access token for /api/admin/* endpoints
ADMIN_TOKEN=secret-admin-token-12345

# AI Provider Configuration: demo | openai | gemini
# When set to 'demo' or left unconfigured, all AI prompts use transparent deterministic demo outputs.
# The mathematical ML models and TF-IDF search always run genuinely regardless of provider.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CRM Integration Configuration: none | webhook | zoho
CRM_PROVIDER=none
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
CRM_FLUSH_INTERVAL_MS=30000

# Base URL of the live Wrench Wise main website (leave empty to use local programme pages)
PROGRAMME_BASE_URL=
